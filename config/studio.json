{
  "language": "ru",
  "default_format": {
    "platform": "reels/shorts/tiktok",
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "container": "mp4",
    "video_codec": "libx264",
    "crf": 19,
    "preset": "slow",
    "audio_codec": "aac",
    "audio_bitrate": "192k",
    "audio_samplerate": 48000,
    "faststart": true
  },
  "supported_formats": [
    { "name": "9:16 vertical", "width": 1080, "height": 1920 },
    { "name": "16:9 landscape", "width": 1920, "height": 1080 },
    { "name": "1:1 square", "width": 1080, "height": 1080 }
  ],
  "loudness_target_lufs": -14,
  "true_peak_dbtp": -1.5,
  "default_duration_sec": { "min": 30, "max": 60 },
  "hardware": {
    "gpu": "NVIDIA GeForce RTX 3050 8GB (CUDA 12.x, драйвер 621.14)",
    "cpu": "Intel i3-12100F",
    "ram_gb": 16,
    "encoders": {
      "nvenc": "h264_nvenc — основной для драфта (--nvenc), замер 1.24 с на сцене 120 кадров",
      "libx264": "fallback (--crf N), замер 0.87 с на той же сцене (маленькая сцена — CPU быстрее)",
      "amf": "недоступен (нет AMD GPU)",
      "qsv": "недоступен (F-серия CPU без iGPU)"
    }
  },
  "tts": {
    "default_engine": "silero",
    "command": "python tools/voice-ru.py",
    "voice": "xenia",
    "device": "auto",
    "silero_voices": ["xenia", "baya", "kseniya", "aidar", "eugene"],
    "pronunciation": "config/pronunciation.json",
    "alternatives": {
      "azure": "F0 500 тыс. символов/мес бесплатно, коммерчески чисто — нужны AZURE_SPEECH_KEY/REGION",
      "edge": "edge-tts, быстро, ударения не контролируются",
      "piper": "локальный MIT, нужен ru_RU-*.onnx + бинарь piper"
    },
    "paid_engine": "elevenlabs-mcp (требует API-ключ и разрешения пользователя)"
  },
  "asr": {
    "engine": "faster-whisper",
    "model": "small",
    "venv_python": "{{STUDIO_DIR}}/.venvs/whisper/Scripts/python.exe"
  },
  "engines": {
    "ffmpeg": "9.0.2 full (libass, freetype, fontconfig, x264, nvenc)",
    "remotion_project": "{{STUDIO_DIR}}/compositions",
    "kinocut": "uvx --from kinocut kino",
    "chatterbox": "НЕ установлен: осознанно исключён (500M-модель, CPU-инференс непрактичен)"
  },
  "agents": [
    "video-scriptwriter",
    "motion-designer",
    "voice-producer",
    "video-editor",
    "video-quality-controller",
    "video-director (координатор)"
  ]
}
